{
  "name": "@code-inlay/backend-gen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "bin": {
    "backend-gen": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean --splitting false",
    "postinstall": "cd tools/decl-parser && go build -o decl-parser . || true",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "generate": "node dist/cli.js generate --config backend.config.ts --cwd sample-project/maemoo",
    "typecheck": "tsc --noEmit",
    "snapshot:update": "UPDATE_SNAPSHOT=true vitest run test/snapshot.test.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "tsx": "^4.20.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.3",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.1",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  }
}
